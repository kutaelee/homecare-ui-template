# Run npm run setup:media, or copy this file to .env.local and set all three values.
# Use an absolute storage folder OUTSIDE the project, on a persistent disk.
MEDIA_STORAGE_DIR=
# At least 12 characters. Never commit the actual password.
MEDIA_ADMIN_PASSWORD=
# The setup wizard uses MEDIA_ADMIN_PASSWORD_B64 instead to preserve special characters.
# This is encoding, not encryption; protect .env.local like a password file.
# At least 32 random characters. Changing this signs out all media administrators.
MEDIA_SESSION_SECRET=
# Production: the external HTTPS origin, without a trailing path.
# Example format only: https://your-domain.example
MEDIA_PUBLIC_ORIGIN=
